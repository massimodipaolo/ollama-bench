# Copy to .env and fill in. A judge without both a key and a model is skipped.

# Ollama host under test: host, host:port or a full URL (port defaults to 11434)
OLLAMA_HOST=
# optional: ollama.com key, sent as Bearer token (also used by the web search test)
OLLAMA_API_KEY=

# Judges
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Cohere: RAG / reranking baseline
COHERE_API_KEY=
COHERE_MODEL=rerank-v4.0-fast
# optional: Cohere calls per minute (default 10, the trial-key limit)
# COHERE_RPM=10

# optional: database location (default ~/.ollama-benchmark/bench.db)
# BENCH_DB_PATH=
# optional: app URL for `pnpm bench` (default http://localhost:3000)
# BENCH_URL=
