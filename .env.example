# Copy to .env and fill in. A judge without both a key and a model is skipped.
# For the Docker image, copy it to .env.docker too (see README "Docker"): a service on this machine is
# host.docker.internal there, e.g. OLLAMA_HOST=host.docker.internal.

# Ollama host under test: host, host:port or a full URL (port defaults to 11434)
OLLAMA_HOST=
# optional: sent as Bearer token to the Ollama host (e.g. behind an authenticating proxy)
OLLAMA_API_KEY=

# Judges
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Cohere: RAG / reranking baseline
COHERE_API_KEY=
COHERE_MODEL=rerank-v4.0-fast
# optional: Cohere calls per minute (default 10, the trial-key limit)
# COHERE_RPM=10

# optional: database location (default ~/.ollama-bench/bench.db)
# BENCH_DB_PATH=
# optional: app URL for `pnpm bench` (default http://localhost:3000)
# BENCH_URL=
