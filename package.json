{
  "name": "ollama-bench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && tsx scripts/standalone-env.mts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx --conditions=react-server --env-file=.env scripts/smoke.ts",
    "rejudge": "tsx --conditions=react-server --env-file=.env scripts/rejudge.mts",
    "bench": "tsx scripts/bench.mts",
    "datasets:fetch": "tsx scripts/datasets/fetch.mts",
    "tb:verify": "tsx scripts/tb-verify.mts",
    "security": "tsx scripts/security.mts",
    "security:codeql": "tsx scripts/codeql.mts",
    "security:secrets": "tsx scripts/gitleaks.mts",
    "prepare": "git config core.hooksPath .githooks || echo prepare: not a git checkout, hooks not installed"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.110",
    "@ai-sdk/cohere": "4.0.88",
    "@ai-sdk/google": "4.0.128",
    "@ai-sdk/mcp": "2.0.106",
    "@ai-sdk/openai": "4.0.125",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.183",
    "ai-sdk-ollama": "4.6.3",
    "better-sqlite3": "13.2.0",
    "dompurify": "^3.5.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "katex": "^0.19.1",
    "mammoth": "1.13.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.11.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "turndown": "7.2.5",
    "unpdf": "2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "5.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "hyparquet": "1.33.2",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "^5",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@12.15.0"
}
