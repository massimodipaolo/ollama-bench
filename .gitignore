# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: secrets stay local; .env.example documents the variables
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data: DB backups, caches, bench reports and downloaded datasets (re-create with `pnpm datasets:fetch`).
# Only the sample source files are versioned: tests read them from .data/files.
/.data/*
!/.data/files/

# logs
*.log

# editor / agent personal settings (shared VS Code tasks and launch configs are versioned)
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.claude/settings.local.json
