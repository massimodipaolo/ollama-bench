# LF everywhere (Prettier expects it; Windows tools otherwise write CRLF)
* text=auto eol=lf

# binaries: never touch line endings or diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.ico binary

# sample input files for the parsing tests: keep their exact bytes (the CSV has CRLF line endings)
.data/files/** -text -diff
