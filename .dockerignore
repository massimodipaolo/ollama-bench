# Build context for the Dockerfile: sources only.

# secrets: the build needs none (next build would copy them into the image, see Dockerfile); settings come at run time
.env*
!.env.example

# installed or generated: rebuilt inside the image
node_modules
.next
*.tsbuildinfo
next-env.d.ts

# local data: only the sample source files the tests read are part of the image
.data/*
!.data/files/

# repository, editor and agent files
.git
.github
.githooks
.vscode
.claude
*.log
coverage
Dockerfile
.dockerignore
